{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SEAM IDE",
  "version": "0.1.0",
  "identifier": "com.seam.ide",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SEAM IDE",
        "width": 1400,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
