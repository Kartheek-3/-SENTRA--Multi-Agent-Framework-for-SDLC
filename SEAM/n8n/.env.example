N8N_BASE_URL=http://localhost:5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_ENCRYPTION_KEY=replace-with-a-long-random-local-key
SEAM_API_URL=http://host.docker.internal:8000
SEAM_CALLBACK_BASE_URL=http://host.docker.internal:8000
SEAM_N8N_INTEGRATION_SECRET=replace-with-a-shared-local-secret
N8N_WEBHOOK_URL=http://localhost:5678/webhook/seam-event-router
N8N_ALLOWED_WORKFLOWS=SEAM_EVENT_ROUTER=http://localhost:5678/webhook/seam-event-router,SEAM_TO_GITHUB=http://localhost:5678/webhook/seam-to-github,SEAM_TO_JIRA=http://localhost:5678/webhook/seam-to-jira,SEAM_TO_FIGMA=http://localhost:5678/webhook/seam-to-figma,SEAM_DELIVERY_TO_CICD=http://localhost:5678/webhook/seam-delivery-to-cicd
N8N_ALLOWED_EVENT_TYPES=DELIVERY_COMPLETED,DELIVERY_BLOCKED,EVALUATION_COMPLETED,EXPERIMENT_COMPLETED,DEFECT_RESOLVED,DEFECT_REMAINING,DEFECT_LOCALIZED,RELEASE_BLOCKED,GITHUB_CONTEXT_REFRESHED,FIGMA_CONTEXT_UPDATED,FRONTEND_REQUIREMENT_READY,CICD_REQUESTED
