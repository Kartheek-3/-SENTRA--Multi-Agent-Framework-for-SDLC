# LLM & Model Runner Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_MODEL=qwen3-coder-next
SEAM_LOCAL_MODEL=ai/qwen3:4b-instruct-2507-q4_K_M
SEAM_CODING_MODEL=qwen3-coder-next
SEAM_ANALYSIS_MODEL=qwen3-coder-next
SEAM_PLANNING_MODEL=qwen3-coder-next
SEAM_QA_MODEL=qwen3-coder-next
SEAM_DELIVERY_MODEL=qwen3-coder-next

# Persistence Configuration
# Development: SQLite (default)
SEAM_DATABASE_BACKEND=sqlite
SEAM_SQLITE_PATH=.seam/runtime/seam.db

# Production: PostgreSQL (when SEAM_DATABASE_BACKEND=postgresql)
# SEAM_DATABASE_BACKEND=postgresql
# DATABASE_URL=postgresql://seam_user:password@localhost:5432/seam_production
# SEAM_POSTGRESQL_URL=postgresql://seam_user:password@localhost:5432/seam_production

# Distributed Cache & Coordination
SEAM_REDIS_URL=redis://localhost:6379/0

# RAG & Semantic Knowledge
CHROMA_PERSIST_DIRECTORY=./chroma_db
SEAM_RAG_MODE=REAL
SEAM_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Integrations
GITHUB_TOKEN=
